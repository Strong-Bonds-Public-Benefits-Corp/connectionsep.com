# Copy to .env for local dev. NEVER commit a real .env.
# NEVER put real credentials in git, in code, or in chat.

# PUBLIC_DB_URI — MongoDB connection string for the PUBLIC database
# (strong-bonds-public). It contains a database password.
# Use a test/dev cluster for local work. Do not point local runs at
# production data unless Tony says so.
PUBLIC_DB_URI=mongodb+srv://<user>:<password>@<cluster-host>/strong-bonds-public?retryWrites=true&w=majority

# JWT_SECRET — REQUIRED. Signs login tokens for the accounts/auth
# endpoints. Generate a long random value, separate from the Vault
# backend's JWT_SECRET.
JWT_SECRET=change-me-to-a-long-random-value

# PORT — Render assigns this in production. Local default is 3000.
PORT=3000

# SQUARE — card payments for orders and club memberships (Step 3).
# Leave blank for local work without payments; POST /api/orders
# answers 503 payments_not_configured until these are set.
# SQUARE_ACCESS_TOKEN — from Square Developer Dashboard (production
# token for the live store; sandbox token for test checkouts).
# SQUARE_LOCATION_ID — the Square location that takes the payment.
# SQUARE_ENVIRONMENT — sandbox (default) or production.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENVIRONMENT=sandbox
